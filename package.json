{
  "name": "@agunggnn/hetzer",
  "version": "0.4.16",
  "description": "Local credential safety for AI-assisted workflows with an encrypted vault, scoped injection, output redaction, MCP proxy, and agent guidance.",
  "bin": {
    "hetzer": "cli/bin/hetzer.js"
  },
  "files": [
    "assets",
    "cli/bin",
    "cli/core",
    "cli/mcp",
    "cli/modules",
    "cli/templates",
    "cli/vault",
    "cli/skills",
    "scripts/check.mjs",
    "scripts/verify-evidence.mjs",
    "scripts/publish.mjs",
    "scripts/publish-github.mjs",
    "scripts/build-package.mjs",
    "scripts/package-stage.mjs",
    "scripts/render-banner.mjs",
    "docs/architecture.md",
    "docs/banner-spec.md",
    "docs/enterprise-readiness.md",
    "docs/http-credential-broker.md",
    "docs/installation.md",
    "docs/mcp-guide.md",
    "docs/modules/cognee.md",
    "docs/system-logic-and-progress.md",
    "docs/value-benchmark.md",
    "docs/verification-evidence.json",
    "docs/vibe-coders.md",
    "modules/cognee",
    ".env.example",
    "docker-compose.yml",
    "LICENSE",
    "NOTICE",
    "README.md",
    "SECURITY.md"
  ],
  "keywords": [
    "ai-security",
    "credential-safety",
    "secret-sniffer",
    "credential-vault",
    "mcp",
    "model-context-protocol",
    "hermes",
    "antigravity",
    "cursor",
    "claude",
    "opencode",
    "commandcode",
    "9router",
    "encryption",
    "local-first",
    "pre-commit-hook"
  ],
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public",
    "registry": "https://npm.pkg.github.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agunggnn/hetzer.git"
  },
  "homepage": "https://github.com/agunggnn/hetzer#readme",
  "bugs": {
    "url": "https://github.com/agunggnn/hetzer/issues"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "check": "node scripts/check.mjs",
    "test": "node --test --test-reporter=dot \"**/*.test.mjs\"",
    "test:verbose": "node --test \"**/*.test.mjs\"",
    "verify": "node scripts/verify-evidence.mjs",
    "build:package": "node scripts/build-package.mjs",
    "lint": "node scripts/check.mjs",
    "render:banner": "node scripts/render-banner.mjs",
    "hetzer": "node cli/bin/hetzer.js",
    "publish:github": "node scripts/publish-github.mjs",
    "publish:npm": "node scripts/publish.mjs",
    "publish-pkg": "node scripts/publish-github.mjs"
  },
  "preferGlobal": true
}
