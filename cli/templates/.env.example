# Hetzer project identity
HETZER_PROJECT_NAME=hetzer
HETZER_BIND_ADDRESS=127.0.0.1

# Grimoire unlock key. `hetzer init` generates it and writes it outside this
# workspace, to ~/.hetzer/keys/<HETZER_INSTANCE_ID>.key (mode 0600), so a tool
# that can read the workspace cannot read the key next to the vault. Credentials
# are stored in data/hetzer-vault.db as AES-256-GCM ciphertext. To supply the key
# another way (CI, containers), set HETZER_GRIMOIRE_KEY in the process environment.
