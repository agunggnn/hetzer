# Hetzer project identity
HETZER_PROJECT_NAME=hetzer
HETZER_BIND_ADDRESS=127.0.0.1
HETZER_VERSION=0.5.0
HETZER_ENABLED_MODULES=
HETZER_DISABLED_MODULES=

# Grimoire unlock key. `hetzer init` generates this value and stores application
# credentials in data/hetzer-vault.db as AES-256-GCM ciphertext.
HETZER_GRIMOIRE_KEY=

# 9Router core (Deprecated in Hetzer; for full ops stacks use Jagdpanzer)
NINE_ROUTER_IMAGE=ghcr.io/decolua/9router@sha256:3eb104460661900d0c387e2cce910fe348201e28dd6b31067f019a23ec04f95d
NINE_ROUTER_PORT=20140
NINE_ROUTER_BASE_URL=http://127.0.0.1:20140
NINE_ROUTER_JWT_SECRET=replace-with-a-long-random-secret
NINE_ROUTER_INITIAL_PASSWORD=replace-before-starting
NINE_ROUTER_API_KEY_SECRET=replace-with-a-long-random-secret
NINE_ROUTER_MACHINE_ID_SALT=replace-with-a-long-random-secret
NINE_ROUTER_REQUIRE_API_KEY=false
NINE_ROUTER_AUTH_COOKIE_SECURE=false
NINE_ROUTER_MEMORY_LIMIT=250m
NINE_ROUTER_CPU_LIMIT=1.0
OLLAMA_HOST=http://host.docker.internal:11434

